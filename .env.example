# Entorno local del servicio de Orquestación
ORQUESTACION_ENV=local
ORQUESTACION_HTTP_HOST=0.0.0.0
ORQUESTACION_HTTP_PORT=8001
ORQUESTACION_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/orquestacion_trabajos
ORQUESTACION_PULSAR_URL=pulsar://localhost:6650
ORQUESTACION_PULSAR_TENANT=public
ORQUESTACION_PULSAR_NAMESPACE=default
ORQUESTACION_ENABLE_LIFESPAN_CONSUMERS=false
