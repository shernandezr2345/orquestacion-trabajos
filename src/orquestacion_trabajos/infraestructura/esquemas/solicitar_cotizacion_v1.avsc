{
  "type": "record",
  "name": "SolicitarCotizacionV1",
  "namespace": "orquestacion.eventos",
  "doc": "Comando para solicitar una cotización",
  "fields": [
    {"name": "command_id", "type": "string", "doc": "Identificador único del comando"},
    {"name": "tipo", "type": "string", "default": "SolicitarCotizacion.v1"},
    {"name": "version_contrato", "type": "int", "default": 1},
    {"name": "instante", "type": "string", "doc": "ISO 8601 UTC"},
    {"name": "correlacion", "type": "string", "doc": "id_solicitud de Entrada"},
    {"name": "causacion", "type": "string", "doc": "event_id de SolicitudDePartnerListaParaAtencion"},
    {"name": "id_peticion", "type": "string", "doc": "Identificador único de la petición = id_trabajo"},
    {"name": "id_trabajo", "type": "string", "doc": "Identificador del Trabajo en Orquestación"},
    {"name": "id_solicitud", "type": "string", "doc": "Referencia a SolicitudDePartnerListaParaAtencion"},
    {"name": "id_partner", "type": "string", "doc": "Partner solicitante"},
    {"name": "categoria", "type": "string", "doc": "Categoría del siniestro"},
    {"name": "tipo_solicitud", "type": "string", "doc": "SINIESTRO o INSTALACION"},
    {"name": "tipo_red", "type": "string", "doc": "GENERAL_HDA o HOMOLOGADA_PARTNER"},
    {"name": "id_politica", "type": "string", "doc": "Política de referencia"},
    {"name": "version_politica", "type": "int", "doc": "Versión de política aplicada"}
  ]
}
