{
  "type": "record",
  "name": "CotizacionRegistradaV1",
  "namespace": "cotizaciones.eventos",
  "doc": "Evento: Cotización registrada (versión 1, congelada)",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "tipo", "type": "string", "default": "CotizacionRegistrada.v1"},
    {"name": "version_contrato", "type": "int", "default": 1},
    {"name": "instante", "type": "string", "doc": "ISO 8601 UTC"},
    {"name": "correlacion", "type": "string"},
    {"name": "causacion", "type": "string"},
    {"name": "id_peticion", "type": "string"},
    {"name": "id_trabajo", "type": "string"},
    {"name": "id_solicitud", "type": "string"},
    {"name": "id_partner", "type": "string"},
    {"name": "id_cotizacion", "type": "string"},
    {"name": "id_proveedor", "type": "string"},
    {"name": "categoria", "type": "string"},
    {"name": "tipo_red", "type": "string"},
    {"name": "importe_menor", "type": "long", "doc": "Monto en unidades menores (centavos)"},
    {"name": "moneda", "type": "string"},
    {"name": "version_catalogo", "type": "int"},
    {"name": "version_cotizacion", "type": "int", "default": 1}
  ]
}
